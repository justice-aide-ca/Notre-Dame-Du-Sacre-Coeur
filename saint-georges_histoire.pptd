version: v2
title: Paroisse Saint-Georges — Histoire vivante
size:
- 960
- 540
theme:
  colors:
    paper: '#F5F0E6'
    ink: '#2B2118'
    primary: '#7A2E2E'
    accent: '#B08A3C'
    muted: '#6F6256'
    dark: '#17110D'
  textStyles:
    title:
      fontFamily: SortsMillGoudy
      color: $ink
      fontSize: 38
      bold: true
    subtitle:
      fontFamily: SortsMillGoudy
      color: $primary
      fontSize: 22
    body:
      fontFamily: QuattrocentoSans
      color: $ink
      fontSize: 17
      lineHeight: 1.4
    quote:
      fontFamily: SortsMillGoudy
      color: $ink
      fontSize: 22
      italic: true
      lineHeight: 1.35
    label:
      fontFamily: QuattrocentoSans
      color: $primary
      fontSize: 12
      letterSpacing: 1.2
    year:
      fontFamily: SortsMillGoudy
      color: $primary
      fontSize: 54
      bold: true
    footer:
      fontFamily: QuattrocentoSans
      color: $muted
      fontSize: 10
pages:
- pages/01_cover.page
- pages/02_split.page
- pages/03_foundation.page
- pages/04_split.page
- pages/05_quote.page
- pages/06_split.page
- pages/07_split.page
- pages/08_pillars.page
- pages/09_split.page
- pages/10_split.page
- pages/11_timeline.page
- pages/12_today.page
- pages/13_closing.page
